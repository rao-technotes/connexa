# Public DNS name pointing at this host.
CONNEXA_DOMAIN=connexa.example.com

# Public IPv4 address of this host (advertised by the SFU and coturn).
PUBLIC_IP=203.0.113.10

# Shared secret between the signaling server and coturn. Generate with:
#   openssl rand -hex 32
TURN_SECRET=change-me

# Origins allowed to open the signaling WebSocket: the web client plus any
# chrome-extension://<extension-id> origins, comma separated.
CONNEXA_ALLOWED_ORIGINS=https://connexa.example.com

# Database password (device identities, trusted devices, audit log).
POSTGRES_PASSWORD=change-me

# Bearer token Prometheus uses to scrape /metrics.
METRICS_TOKEN=change-me

# Grafana admin password (only with --profile monitoring).
GRAFANA_PASSWORD=change-me
